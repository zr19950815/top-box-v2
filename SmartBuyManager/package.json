{
  "name": "smartbuy-manager",
  "version": "1.0.0",
  "description": "SmartBuy Framework 任务管理和监控系统",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:backend": "echo 'Backend build completed'",
    "build:frontend": "cd frontend && npm run build",
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop ecosystem.config.js",
    "restart": "pm2 restart ecosystem.config.js",
    "test": "jest",
    "db:init": "node backend/database/init.js",
    "db:migrate": "node backend/database/migrate.js"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "moment": "^2.29.4",
    "pm2": "^5.3.0",
    "socket.io": "^4.7.4",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "axios": "^1.11.0",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "smartbuy",
    "task-management",
    "automation",
    "monitoring"
  ],
  "author": "SmartBuy Team",
  "license": "MIT"
}
