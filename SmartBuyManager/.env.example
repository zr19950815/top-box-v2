# SmartBuy Manager 环境变量配置示例
# 复制此文件为 .env 并修改相应配置

# 服务器配置
NODE_ENV=development
PORT=3001
HOST=localhost

# 跨域配置
CORS_ORIGIN=http://localhost:3000

# 数据库配置
DB_PATH=./storage/database/smartbuy.db

# SmartBuy Framework 集成配置
FRAMEWORK_PATH=../SmartBuyFramework
MAX_CONCURRENT_TASKS=10

# 日志配置
LOG_LEVEL=info

# 安全配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# WebSocket配置
WS_PING_TIMEOUT=60000
WS_PING_INTERVAL=25000

# NapCat / OneBot 11 QQ 机器人
QQ_BOT_ENABLED=false
QQ_BOT_WS_URL=ws://127.0.0.1:3002
QQ_BOT_ACCESS_TOKEN=
QQ_BOT_WEBUI_TOKEN=
QQ_BOT_ACCOUNT=
QQ_BOT_COMMAND_PREFIX=/topbox
# 允许在私聊中直接发送任务格式。开启后任意好友均可提交，任务绑定给发送者本人；
# 群聊只用于单向公告，不提供任何交互功能，因此没有 QQ 或群白名单。
QQ_BOT_DIRECT_COMMANDS_ENABLED=false
# 非任务私聊的自动测试回复，留空则静默忽略
QQ_BOT_PRIVATE_TEST_REPLY=
# 「获取任务」给出的编号有效期（毫秒），过期后需重新查询
QQ_BOT_TASK_SELECTION_TTL_MS=300000
QQ_BOT_RECONNECT_INTERVAL_MS=5000
QQ_BOT_ACTION_TIMEOUT_MS=10000

# NewBee 新公告定时推送
NEWBEE_ANNOUNCEMENT_ENABLED=false
NEWBEE_ANNOUNCEMENT_INTERVAL_MS=60000
NEWBEE_ANNOUNCEMENT_QQ_GROUP=
NEWBEE_ANNOUNCEMENT_STATE_FILE=./storage/qq/newbee-announcement.json
